# Production .env for Alpha Sniper v4.2 (Phase 1.1 + Hold Brain)
# Copy this to .env and fill in your real values

# === EXCHANGE & MODE ===
ALPHA_MODE=LIVE
ALPHA_EXCHANGE_ID=mexc
ALPHA_API_KEY=YOUR_MEXC_API_KEY_HERE
ALPHA_API_SECRET=YOUR_MEXC_SECRET_HERE
ALPHA_TESTNET=false

# === UNIVERSE (IMPORTANT: Set to 40 to avoid rate limits!) ===
ALPHA_UNIVERSE_SIZE=40
ALPHA_UNIVERSE_BASE_QUOTE=USDT
ALPHA_UNIVERSE_MIN_QUOTE_VOLUME=50000.0
ALPHA_UNIVERSE_CACHE_TTL=300

# === SCANNING ===
ALPHA_SCAN_INTERVAL_SECONDS=300
ALPHA_SCAN_CONCURRENCY=5
ALPHA_TIMEFRAME=1m

# === TELEGRAM (Optional) ===
ALPHA_TELEGRAM_ENABLED=true
ALPHA_TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ALPHA_TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# === RISK MANAGEMENT ===
ALPHA_MAX_PORTFOLIO_HEAT=0.012
ALPHA_MAX_CONCURRENT_POSITIONS=5
ALPHA_RISK_PER_TRADE=0.0025
ALPHA_DAILY_LOSS_CAP_PCT=-0.02
ALPHA_STREAK_BREAKER_LOSSES=3
ALPHA_STREAK_BREAKER_COOLDOWN_MIN=60

# === LIVE TEST MODE (Safety limits for testing) ===
ALPHA_LIVE_TEST_MODE=true
ALPHA_LIVE_TEST_MAX_ORDERS_PER_DAY=3
ALPHA_LIVE_TEST_MAX_USD_PER_ORDER=7.5

# === SIGNAL DETECTION ===
ALPHA_PUMP_ONLY_MODE=true
ALPHA_MIN_SCORE=28
ALPHA_MIN_24H_QUOTE_VOLUME=47000.0

# === EARLY PUMP DETECTION ===
ALPHA_EARLY_ENABLE=true
ALPHA_EARLY_RET_5M_MIN=0.03
ALPHA_EARLY_VOL_SPIKE_MIN=3.0
ALPHA_EARLY_ACCEL_REQUIRED=true
ALPHA_EARLY_REQUIRE_SCORE=false
ALPHA_EARLY_REQUIRE_BULL=false

# === PHASE 1.1: COOLDOWN & WICK FILTER ===
ALPHA_COOLDOWN_PER_SYMBOL_SEC=120
ALPHA_WICK_FILTER_ENABLE=true
ALPHA_WICK_FILTER_ATR_MULT=2.0
ALPHA_MIN_DEPTH_USD_ABSOLUTE=25000.0

# === PHASE 1.1: DIGEST & TRACKING ===
ALPHA_DIGEST_ENABLE=true
ALPHA_DIGEST_HOUR_UTC=0
ALPHA_IOC_REJECT_TRACKING=true
ALPHA_SLIPPAGE_TRACKING=true

# === DYNAMIC HOLD BRAIN ===
ALPHA_HOLD_BRAIN_ENABLE=true
ALPHA_HOLD_BRAIN_PROMOTE_R_MIN=2.5
ALPHA_HOLD_BRAIN_PROMOTE_RVOL_MIN=1.5
ALPHA_HOLD_BRAIN_PROMOTE_EMA_SLOPE_MIN=0.0
ALPHA_HOLD_BRAIN_PROMOTE_EXTEND_MIN=10
ALPHA_HOLD_BRAIN_DEMOTE_FLAT_MIN=2
ALPHA_HOLD_BRAIN_TRAILING_STOP_R_TRIGGER=1.5
ALPHA_HOLD_BRAIN_TRAILING_STOP_PCT=0.02
ALPHA_HOLD_BRAIN_MAX_HOLD_HOURS=8.0

# === ORDER EXECUTION ===
ALPHA_AGGRESSIVE_LIMIT_IOC=true
ALPHA_AGG_LIMIT_MAX_SLIP_PCT=0.0015
ALPHA_MIN_VIABLE_TRADE_USD=5.0
ALPHA_MAX_SPREAD_PCT_ORDER=0.3
ALPHA_MIN_DEPTH_MULTIPLE=200.0
ALPHA_MIN_DEPTH_USD=0.0
ALPHA_MIN_LIQ_FACTOR=0.4
ALPHA_MIN_ADJUSTED_USD=5.0

# === QUICK EXITS ===
ALPHA_QUICK_EXIT_ENABLE=true
ALPHA_QUICK_TP_PCT=0.02
ALPHA_QUICK_SL_PCT=0.01
ALPHA_QUICK_MAX_HOLD_MIN=5

# === DATABASE & LOGGING ===
ALPHA_DB_PATH=./data/alpha.db
ALPHA_LOG_LEVEL=INFO
ALPHA_LOG_FORMAT=json
ALPHA_LOG_FILE=./logs/bot.log
