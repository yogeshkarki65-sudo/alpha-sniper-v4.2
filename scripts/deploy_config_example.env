#################################################################################
# Alpha Sniper v4.2.3 - Deployment Configuration
#
# Copy this file to deploy_config.env and customize for your environment
# Usage: cp scripts/deploy_config_example.env scripts/deploy_config.env
#################################################################################

# Service name (systemd service managing the bot)
SERVICE_NAME=alpha-sniper-live.service

# Log file location
LOG_FILE=/opt/alpha-sniper/logs/bot.log

# Python virtual environment
VENV_PATH=/opt/alpha-sniper/venv
PYTHON_BIN=/opt/alpha-sniper/venv/bin/python
PIP_BIN=/opt/alpha-sniper/venv/bin/pip

# Health check timeout (seconds to wait for bot scan activity)
HEALTH_CHECK_TIMEOUT=60

# Enable/disable automatic rollback on deployment failure
ROLLBACK_ENABLED=true

#################################################################################
# Example configurations for different setups:
#################################################################################

# === PRODUCTION (systemd service) ===
# SERVICE_NAME=alpha-sniper-live.service
# LOG_FILE=/opt/alpha-sniper/logs/bot.log
# VENV_PATH=/opt/alpha-sniper/venv

# === DEV (manual python) ===
# SERVICE_NAME=  # Leave empty to skip service operations
# LOG_FILE=./logs/bot.log
# VENV_PATH=./venv

# === CUSTOM PATHS ===
# VENV_PATH=/home/myuser/.virtualenvs/alpha-sniper
# PYTHON_BIN=/home/myuser/.virtualenvs/alpha-sniper/bin/python3.11
